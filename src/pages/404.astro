---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist." noindex>
  <div class="container-prose py-24 text-center">
    <p class="mb-2 font-mono text-sm text-ink-500">404</p>
    <h1 class="mb-4 font-serif text-4xl font-semibold text-ink-900">This page does not exist.</h1>
    <p class="mb-8 text-ink-600">The link may be wrong, or the page may have moved.</p>
    <a href="/" class="inline-flex rounded-full bg-ink-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-ink-800">
      Back to home
    </a>
  </div>
</BaseLayout>
