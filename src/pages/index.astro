---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonSchema from '../components/PersonSchema.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../consts';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const lead = posts.find((p) => p.data.featured) ?? posts[0];
const secondaryFeatured = posts.filter((p) => p.data.featured && p.slug !== lead?.slug).slice(0, 2);
const recent = posts
  .filter((p) => p.slug !== lead?.slug && !secondaryFeatured.find((s) => s.slug === p.slug))
  .slice(0, 6);

const topGuides = [
  {
    href: '/posts/claude-code-dreaming-guide/',
    title: 'Claude Code AutoDream and the /dream command',
    blurb: 'How AutoDream cleans your MEMORY.md between sessions.',
  },
  {
    href: '/posts/claude-code-skills-complete-guide/',
    title: 'How to build a Claude Code Skill (SKILL.md walkthrough)',
    blurb: 'The SKILL.md format, where skills live on disk, and how to test them.',
  },
  {
    href: '/posts/fix-cannotpullcontainererror-ecs/',
    title: 'CannotPullContainerError on ECS Fargate: 7 root causes and fixes',
    blurb: 'Match the error message to one of the seven causes and apply the fix.',
  },
  {
    href: '/posts/claude-code-slow-fix/',
    title: 'Claude Code slow? 7 real fixes for /doctor, /compact, and MCP bloat',
    blurb: 'Diagnose the slowdown with /doctor and clear it with the right /compact pattern.',
  },
  {
    href: '/posts/what-is-aws-ecs-express-mode/',
    title: 'AWS ECS Express Mode vs Fargate vs App Runner',
    blurb: 'What Express Mode builds for you and when to pick it over the alternatives.',
  },
];
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <PersonSchema slot="head" />

  <section class="border-b border-ink-200 bg-white">
    <div class="container-page py-16 sm:py-24">
      <p class="mb-4 text-sm font-medium uppercase tracking-wider text-accent">Writing</p>
      <h1 class="max-w-3xl font-serif text-4xl font-semibold leading-tight tracking-tight text-ink-900 sm:text-5xl md:text-6xl">
        Honest writing on AI engineering, from someone who builds it.
      </h1>
      <p class="mt-6 max-w-2xl font-serif text-lg leading-relaxed text-ink-600 sm:text-xl">
        Hi, I'm Moeed. I write tested, no-fluff articles on Claude Code, the Claude Agent SDK, MCP servers, and the kind of RAG patterns that survive real users. Every article ships with working code.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/archive" class="inline-flex items-center rounded-full bg-ink-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-ink-800">
          Browse all articles
        </a>
        <a href="/about" class="inline-flex items-center rounded-full border border-ink-300 bg-white px-5 py-2.5 text-sm font-medium text-ink-700 hover:bg-ink-100">
          About me
        </a>
      </div>
    </div>
  </section>

  {lead && (
    <section class="border-b border-ink-200">
      <div class="container-page py-14">
        <p class="mb-8 text-xs font-semibold uppercase tracking-wider text-ink-500">Featured</p>
        <PostCard post={lead} variant="featured" />
      </div>
    </section>
  )}

  {secondaryFeatured.length > 0 && (
    <section class="border-b border-ink-200 bg-white">
      <div class="container-page py-14">
        <p class="mb-8 text-xs font-semibold uppercase tracking-wider text-ink-500">Also worth reading</p>
        <div class="grid gap-12 sm:grid-cols-2">
          {secondaryFeatured.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <section class="border-b border-ink-200 bg-white">
    <div class="container-page py-14">
      <p class="mb-8 text-xs font-semibold uppercase tracking-wider text-ink-500">Top guides</p>
      <ul class="grid gap-4 sm:grid-cols-2">
        {topGuides.map((guide) => (
          <li>
            <a href={guide.href} class="block h-full rounded-lg border border-ink-200 p-5 transition hover:border-accent hover:bg-ink-50">
              <span class="block font-serif text-lg font-semibold leading-snug text-ink-900">{guide.title}</span>
              <span class="mt-2 block text-sm leading-relaxed text-ink-600">{guide.blurb}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-b border-ink-200">
    <div class="container-page py-14">
      <div class="mb-8 flex items-baseline justify-between">
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">Recent</p>
        <a href="/archive" class="text-sm text-accent hover:underline">All articles →</a>
      </div>
      <div class="grid gap-y-2">
        {recent.map((post) => <PostCard post={post} variant="compact" />)}
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-page py-16">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-serif text-3xl font-semibold text-ink-900">Get an article in your inbox</h2>
        <p class="mt-3 text-base leading-relaxed text-ink-600">
          One thoughtful tutorial a week. No spam, no marketing. You can leave any time.
        </p>
        <form class="mt-6 flex flex-col gap-2 sm:flex-row sm:justify-center" onsubmit="event.preventDefault(); alert('Connect your Buttondown or ConvertKit endpoint here.');">
          <input
            type="email"
            required
            placeholder="you@example.com"
            class="w-full rounded-full border border-ink-300 bg-white px-5 py-3 text-sm placeholder-ink-400 focus:border-accent focus:outline-none sm:w-72"
          />
          <button type="submit" class="rounded-full bg-ink-900 px-5 py-3 text-sm font-medium text-white hover:bg-ink-800">
            Subscribe
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
