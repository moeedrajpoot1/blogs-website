---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  variant?: 'default' | 'compact' | 'featured';
}

const { post, variant = 'default' } = Astro.props;
const formatted = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

{variant === 'featured' ? (
  <article class="group">
    <a href={`/posts/${post.slug}`} class="block">
      <div class="mb-3 flex items-center gap-2 text-xs text-ink-500">
        {post.data.tags[0] && (
          <span class="font-medium uppercase tracking-wider text-accent">{post.data.tags[0]}</span>
        )}
        <span>·</span>
        <time datetime={post.data.pubDate.toISOString()}>{formatted}</time>
      </div>
      <h2 class="mb-3 font-serif text-2xl font-semibold leading-snug text-ink-900 group-hover:text-accent sm:text-3xl">
        {post.data.title}
      </h2>
      <p class="text-base leading-relaxed text-ink-600">
        {post.data.description}
      </p>
      <p class="mt-4 text-sm font-medium text-accent">Read article →</p>
    </a>
  </article>
) : variant === 'compact' ? (
  <article class="group border-b border-ink-200 py-5 last:border-0">
    <a href={`/posts/${post.slug}`} class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
      <div class="flex-1">
        <h3 class="font-serif text-base font-semibold text-ink-900 group-hover:text-accent">
          {post.data.title}
        </h3>
      </div>
      <time class="shrink-0 font-mono text-xs text-ink-500" datetime={post.data.pubDate.toISOString()}>
        {formatted}
      </time>
    </a>
  </article>
) : (
  <article class="group">
    <a href={`/posts/${post.slug}`} class="block">
      <div class="mb-2 flex items-center gap-2 text-xs text-ink-500">
        {post.data.tags[0] && (
          <span class="font-medium uppercase tracking-wider text-accent">{post.data.tags[0]}</span>
        )}
        <span>·</span>
        <time datetime={post.data.pubDate.toISOString()}>{formatted}</time>
      </div>
      <h2 class="mb-2 font-serif text-xl font-semibold leading-snug text-ink-900 group-hover:text-accent">
        {post.data.title}
      </h2>
      <p class="text-sm leading-relaxed text-ink-600 line-clamp-2">
        {post.data.description}
      </p>
    </a>
  </article>
)}
